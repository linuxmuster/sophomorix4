#! /bin/sh
# postinst script for sophomorix
#
# see: dh_installdeb(1)

set -e

# Up to 7.4.4, sophomorix-postinst installed the diceware python package with
# pip. It is now a debian dependency (see debian/control), but the pip copy in
# /usr/local/bin shadows /usr/bin/diceware in the PATH: without this cleanup the
# obsolete copy keeps being used and is never upgraded. Only /usr/local is
# touched here, never the files of the debian package.
remove_pip_diceware() {
    rm -f /usr/local/bin/diceware
    rm -rf /usr/local/lib/python3*/dist-packages/diceware \
           /usr/local/lib/python3*/dist-packages/diceware-*.dist-info
}

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package
#
# quoting from the policy:
#     Any necessary prompting should almost always be confined to the
#     post-installation script, and should be protected with a conditional
#     so that unnecessary prompting doesn't happen if a package's
#     installation fails and the `postinst' is called with `abort-upgrade',
#     `abort-remove' or `abort-deconfigure'.

case "$1" in
    configure)
    remove_pip_diceware

    # calling the postinst-script of sophomorix
    sophomorix-postinst
    ;;

    install)
    # option install is necessary to avoid errors ???

    remove_pip_diceware

    # calling the postinst-script of sophomorix
    sophomorix-postinst
    ;;


    upgrade)
    # option upgrade is necessary to avoid errors ???
    remove_pip_diceware

    # calling the postinst-script of sophomorix
    sophomorix-postinst
    ;;


    abort-upgrade|abort-remove|abort-deconfigure)

    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0


